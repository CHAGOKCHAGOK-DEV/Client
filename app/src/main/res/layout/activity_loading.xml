<?xml version="1.0" encoding="utf-8"?>
<!-- S01_2 로딩중 / 로딩실패. 같은 화면에서 두 그룹을 바꿔 보여준다 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_soft"
    tools:context=".ui.loading.LoadingActivity">

    <!-- ===== 로딩중 ===== -->
    <LinearLayout
        android:id="@+id/group_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- 말풍선 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_bubble"
                android:layout_width="532dp"
                android:layout_height="100dp"
                android:background="@drawable/bg_bubble"
                android:gravity="center"
                android:text="@string/loading_bubble"
                android:textColor="@color/gray_500"
                android:textSize="36px"
                android:textStyle="normal" />

            <ImageView
                android:layout_width="28dp"
                android:layout_height="21dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_bubble_tail" />
        </LinearLayout>

        <!-- 일러스트 자리 (달려가는 부기) -->
        <FrameLayout
            android:layout_width="416dp"
            android:layout_height="416dp"
            android:layout_marginTop="40dp"
            android:background="@drawable/bg_illust_placeholder">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="@string/loading_illust_placeholder"
                android:textColor="@color/text_secondary"
                android:textSize="28sp" />
        </FrameLayout>

        <!-- 상태 문구 + 회전 아이콘 -->
        <LinearLayout
            android:layout_width="900dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="36px"
                tools:text="차와 연결하고 있어요" />

            <ImageView
                android:id="@+id/iv_spinner"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="12dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_loading_spinner" />
        </LinearLayout>

        <!-- 진행 바 -->
        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="900dp"
            android:layout_height="24dp"
            android:layout_marginTop="20dp"
            android:indeterminate="false"
            android:max="1000"
            android:progress="0"
            android:progressDrawable="@drawable/bg_progress" />
    </LinearLayout>

    <!-- ===== 로딩실패 ===== -->
    <LinearLayout
        android:id="@+id/group_fail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_warning" />

        <TextView
            android:id="@+id/tv_fail_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="@string/fail_car_conn_title"
            android:textColor="@color/text_primary"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_fail_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/fail_car_conn_sub"
            android:textColor="@color/text_secondary"
            android:textSize="28sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="56dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_retry"
                android:layout_width="256dp"
                android:layout_height="92dp"
                android:background="@drawable/bg_btn_primary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/btn_retry"
                android:textColor="@color/on_brand"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_close"
                android:layout_width="256dp"
                android:layout_height="92dp"
                android:layout_marginStart="24dp"
                android:background="@drawable/bg_btn_secondary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/btn_close"
                android:textColor="@color/brand_strong"
                android:textSize="28sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>