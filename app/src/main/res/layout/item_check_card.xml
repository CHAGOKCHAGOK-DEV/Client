<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="844dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_check_card"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="32dp"
    android:paddingTop="28dp"
    android:paddingBottom="32dp">

    <View
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_checkbox"
        android:duplicateParentState="true" />

    <TextView
        android:id="@+id/tv_check_title"
        style="@style/ChagokText.Bold36"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        tools:text="[필수] 서비스 이용약관 동의" />

    <TextView
        android:id="@+id/tv_check_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginVertical="-12dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="-12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:fontFamily="@font/asta_sans"
        android:includeFontPadding="false"
        android:padding="12dp"
        android:text="@string/consent_view"
        android:textColor="@color/gray_500"
        android:textFontWeight="500"
        android:textSize="28sp"
        android:visibility="gone"
        tools:visibility="visible" />
</LinearLayout>