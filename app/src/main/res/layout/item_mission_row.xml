<?xml version="1.0" encoding="utf-8"?>
<!-- S-05 미션 행 (피그마 S05_미션행). bindMissionRow()로 채운다 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_permission_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="24dp"
    android:paddingTop="20dp"
    android:paddingEnd="32dp"
    android:paddingBottom="24dp">

    <FrameLayout
        android:id="@+id/tile_mission_icon"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/bg_icon_tile"
        tools:backgroundTint="@color/mission_tile_blinker">

        <ImageView
            android:id="@+id/iv_mission_icon"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            tools:src="@drawable/ic_mission_blinker" />
    </FrameLayout>

    <TextView
        android:id="@+id/tv_mission_title"
        style="@style/ChagokText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/gray_600"
        android:textFontWeight="600"
        android:textSize="36sp"
        tools:text="깜빡이 소리" />

    <TextView
        android:id="@+id/tv_mission_status"
        style="@style/ChagokChip"
        android:layout_marginStart="16dp"
        android:paddingVertical="10dp"
        android:textFontWeight="600"
        android:textStyle="normal"
        tools:text="사용 가능" />
</LinearLayout>
